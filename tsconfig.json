{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/design-system": ["src/design-system"],
      "@/design-system/*": ["src/design-system/*"]
    }
  },
  "include": ["src"]
}
